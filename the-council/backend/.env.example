# Copy this to .env and fill in your values

# Required
ANTHROPIC_API_KEY=your-api-key-here

# Database
# Local (default): SQLite, zero setup
DATABASE_URL=sqlite+aiosqlite:///./council.db
# Production (Railway): uncomment and set your PostgreSQL URL
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/council

# CORS — add your Vercel domain here
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
