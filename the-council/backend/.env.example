# Copy this to .env and fill in your values

# Required
ANTHROPIC_API_KEY=your-api-key-here

# Database
# Local (default): SQLite, zero setup
DATABASE_URL=sqlite+aiosqlite:///./council.db
# Production (Railway): uncomment and set your PostgreSQL URL
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/council

# CORS — add your Vercel domain here
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Optional: Static API key to protect all /api/* routes (leave blank to disable)
API_KEY=

# Optional: Tavily API key for live web search in Private Desk tool calls
# Get a free key (1000 searches/mo) at https://tavily.com
# Without this, web_search falls back to curated finance data only
TAVILY_API_KEY=
