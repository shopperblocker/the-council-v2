# Copy this to .env.local and fill in your values.

# ── Proxy-based setup (recommended, eliminates CORS) ──────────────────────────
# Next.js rewrites /api/* to this backend URL server-side.
# The browser never makes a cross-origin request, so no CORS config needed.
#
# Local development:
BACKEND_URL=http://localhost:8000
# Production (Vercel + Railway): set BACKEND_URL in the Vercel dashboard.
# BACKEND_URL=https://your-backend.railway.app

# ── Direct-access setup (optional override) ────────────────────────────────────
# Set NEXT_PUBLIC_API_URL only if you want the browser to call the backend
# directly (bypasses the proxy). Requires proper CORS_ORIGINS on the backend.
# NEXT_PUBLIC_API_URL=http://localhost:8000/api
